{
  "name": "inatrace-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:test": "ng build --configuration production",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "lint": "ng lint",
    "generate-api": "node generate-api.js",
    "generate-chain-api": "node generate-chain-api.js",
    "generate-farmer-import-api": "node scripts/generate-farmer-import-api.js",
    "check-farmer-import-api": "node scripts/generate-farmer-import-api.js --check",
    "extract-i18n-generate-translations": "node generate-translations.js",
    "dev": "ng serve --configuration=dev --host 0.0.0.0 --proxy-config proxy.INATrace-local.conf.json",
    "dev-poll": "ng serve --configuration=dev --host 0.0.0.0 --proxy-config proxy.INATrace-local.conf.json --poll 2000"
  },
  "private": true,
  "dependencies": {
